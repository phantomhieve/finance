# Django
DJANGO_SECRET_KEY=change-me-generate-with-get_random_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Database (PostgreSQL in production; omit for SQLite dev)
# DATABASE_URL=postgres://vault_user:CHANGE_ME@localhost:5432/vault_db

# Public site URL (OAuth redirects, links)
VAULT_PUBLIC_URL=http://localhost:8000

# Google OAuth (django-allauth)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Google Sheets sync + GCS backups (service account JSON path)
GOOGLE_SHEETS_CREDENTIALS=credentials/google-service-account.json
# Alternative standard name (optional if GOOGLE_SHEETS_CREDENTIALS is set):
# GOOGLE_APPLICATION_CREDENTIALS=credentials/google-service-account.json

# GCS bucket for backup_db management command
BACKUP_GCS_BUCKET=your-gcs-bucket-name

# Multi-DB backup script (scripts/backup-all-dbs.sh)
BACKUP_SA_JSON_PATH=credentials/backup-sa.json
BACKUP_DATABASES=vault_db
BACKUP_LOG_FILE=/var/log/vault/backup.log
BACKUP_PYTHON=venv/bin/python3

# WebAuthn (Face ID / biometric unlock)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8000


# AI Insights Provider: 'shakti' or 'gemini' (defaults to 'shakti' if SHAKTI_API_KEY is set, else 'gemini')
AI_PROVIDER=shakti

# Shakti Cloud AI (Yotta Shakti Studio / OpenAI-compatible endpoint)
SHAKTI_API_KEY=your-shakti-cloud-api-key
SHAKTI_BASE_URL=https://http.prod-llm.shaktistudio.shakticloud.ai
SHAKTI_CLIENT_ID=your-shakti-client-id
SHAKTI_MODEL=llama3_3
# SHAKTI_MAX_RETRIES=3
# SHAKTI_RETRY_DELAY=3

# Gemini AI insights (fallback or alternative)
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.1-pro-preview
# Private household context for AI (gitignored; copy from investor_profile.md.example)
# VAULT_INVESTOR_PROFILE_PATH=portfolio/investor_profile.md

# Scheduled emails (Gmail SMTP; leave EMAIL_HOST_USER empty to print emails to console)
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
# Recipient for monthly / weekly / FY review emails
# VAULT_REPORT_EMAIL=you@example.com

# Expense tracker (Gmail-detected spend). Reuses GOOGLE_OAUTH_CLIENT_ID/SECRET above.
# In the same Google Cloud project: enable the Gmail API, add the gmail.readonly scope to the
# OAuth consent screen and set it to "In production" (Testing-mode refresh tokens expire after 7 days),
# then add <VAULT_PUBLIC_URL>/expenses/gmail/callback/ as an authorised redirect URI.
# Key for encrypting Gmail refresh tokens + statement passwords (derived from SECRET_KEY if unset).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# EXPENSES_ENCRYPTION_KEY=
# Model for categorisation / extraction (defaults to the fast portfolio model)
# EXPENSES_GEMINI_MODEL=gemini-2.5-flash-lite

# Gunicorn (production)
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_ACCESS_LOG=/var/log/vault/gunicorn-access.log
GUNICORN_ERROR_LOG=/var/log/vault/gunicorn-error.log
